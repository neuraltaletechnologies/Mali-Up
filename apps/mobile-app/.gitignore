# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase configuration - NEVER commit real credentials
lib/firebase_options.dart
android/app/google-services.json

# Environment variables and secrets
.env
.env.json
.env.local
.env.*.local
sentry.local.json

# iOS certificates and provisioning profiles
ios/Certificates/
ios/*.mobileprovision
ios/*.p8

# Android keystore
android/app/*.keystore
android/app/*.jks
android/app/keystore/
android/key.properties

# Secrets
/secrets/
*.pem
*.key
*.der

# IDE credential files
launch.json
settings.json

# functions/ is npm-managed (Firebase Cloud Functions deploy expects
# package-lock.json) — a stray pnpm-lock.yaml here makes Cloud Build's
# buildpack switch to pnpm mode and fail deploys with a missing
# @google-cloud/functions-framework dependency. Never commit one.
functions/pnpm-lock.yaml
