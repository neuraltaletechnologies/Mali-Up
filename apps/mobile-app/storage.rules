rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if the authenticated user matches the given userId
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Allow users to upload and delete their own business logos
    match /businesses/{userId}/{allPaths=**} {
      // Scoped to the owner, matching write's existing trust boundary — any
      // signed-in user (not just this owner) could previously read every
      // path here, leaking business logos/profile photos/documents across
      // tenants to anyone who obtained a userId (e.g. via a Firestore leak).
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Allow users to upload and delete their own profile pictures
    match /users/{userId}/{allPaths=**} {
      // Scoped to the owner, matching write's existing trust boundary — any
      // signed-in user (not just this owner) could previously read every
      // path here, leaking business logos/profile photos/documents across
      // tenants to anyone who obtained a userId (e.g. via a Firestore leak).
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Allow users to upload and manage their business documents
    match /documents/{userId}/{allPaths=**} {
      // Scoped to the owner, matching write's existing trust boundary — any
      // signed-in user (not just this owner) could previously read every
      // path here, leaking business logos/profile photos/documents across
      // tenants to anyone who obtained a userId (e.g. via a Firestore leak).
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Allow users to upload and manage their own expense receipt photos
    match /receipts/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Allow users to upload proof-of-return photos (damaged goods, etc.)
    // attached to a credit note. Scoped to the uploader, like receipts.
    match /returns/{userId}/{allPaths=**} {
      allow read: if isSignedIn() && isOwner(userId);
      allow write: if isSignedIn() && isOwner(userId);
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
