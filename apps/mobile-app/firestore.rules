rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Prevents full-collection scans while allowing single-document lookups.
    function isLimitedLookup() {
      return request.query.limit != null && request.query.limit <= 1;
    }

    // CMS/admin write access (e.g. updating lookups).
    function isCms() {
      return request.auth != null && (
        request.auth.token.cms == true || request.auth.token.admin == true
      );
    }

    // Returns true when the signed-in user is the owner of this business.
    function isBusinessOwner(bizId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid;
    }

    // Returns true when the signed-in user is an active staff member of
    // this business holding at least one of the given permissions.
    function isStaffWithAny(bizId, permissions) {
      // Staff docs have auto-generated IDs, so they can't be looked up by auth UID.
      // During invite acceptance the app creates a UID-keyed pointer doc at
      // staff/{auth.uid} that mirrors the permissions from the owner-controlled doc.
      // The CREATE rule below ensures permissions can't be self-elevated.
      let ref = /databases/$(database)/documents/businesses/$(bizId)/staff/$(request.auth.uid);
      return isSignedIn() &&
        exists(ref) &&
        get(ref).data.status == 'active' &&
        get(ref).data.permissions.hasAny(permissions);
    }

    // Owner OR active staff with any of the listed permissions.
    function isOwnerOrStaffWithAny(bizId, permissions) {
      return isSignedIn() && (isBusinessOwner(bizId) || isStaffWithAny(bizId, permissions));
    }

    // Auth email is derived from phone as '<digits>@mali.up'.
    function authEmailMatchesPhone(phone) {
      let digits = phone.replace('[^0-9]', '');
      return request.auth.token.email == digits + '@mali.up' ||
        (digits.matches('0[0-9]+') &&
          request.auth.token.email == '255' + digits.replace('^0', '') + '@mali.up');
    }

    // ── Validators ────────────────────────────────────────────────────────────

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.phone is string && data.phone.size() <= 32 &&
        (!data.keys().hasAny(['email'])              || data.email is string) &&
        (!data.keys().hasAny(['balance'])             || data.balance is string || data.balance is number) &&
        (!data.keys().hasAny(['lastTransactionDate']) || data.lastTransactionDate is string || data.lastTransactionDate is timestamp) &&
        (!data.keys().hasAny(['tags'])                || data.tags is list) &&
        (!data.keys().hasAny(['isOrganisation'])      || data.isOrganisation is bool) &&
        (!data.keys().hasAny(['tinNumber'])            || data.tinNumber is string) &&
        (!data.keys().hasAny(['address'])              || data.address is string);
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['phone', 'name']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
        (!data.keys().hasAny(['firstName'])    || data.firstName is string) &&
        (!data.keys().hasAny(['lastName'])     || data.lastName is string) &&
        (!data.keys().hasAny(['language'])     || data.language in ['en', 'sw']) &&
        (!data.keys().hasAny(['isTeamMember']) || data.isTeamMember is bool) &&
        (!data.keys().hasAny(['businessId'])   || data.businessId is string) &&
        (!data.keys().hasAny(['selectedBusinessId']) || data.selectedBusinessId is string);
    }

    function isValidBusinessCreate(data) {
      return data.keys().hasAll(['ownerUid', 'businessName']) &&
        data.ownerUid == request.auth.uid &&
        data.businessName is string &&
        data.businessName.size() > 0 &&
        data.businessName.size() <= 200 &&
        (!data.keys().hasAny(['businessCategory']) || data.businessCategory is string) &&
        (!data.keys().hasAny(['city'])             || data.city is string) &&
        (!data.keys().hasAny(['district'])         || data.district is string) &&
        (!data.keys().hasAny(['region'])           || data.region is string) &&
        (!data.keys().hasAny(['country'])          || data.country is string);
    }

    function isValidWorkerCreate(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 32 &&
        (!data.keys().hasAny(['language']) || data.language in ['en', 'sw']);
    }

    function isValidSaleInvoice(data) {
      return data.keys().hasAll(['amount', 'items', 'status']) &&
        data.amount is number && data.amount >= 0 &&
        data.items is list &&
        data.status is string && data.status.size() > 0 && data.status.size() <= 50 &&
        (!data.keys().hasAny(['totalAmount'])  || data.totalAmount is number) &&
        (!data.keys().hasAny(['amountPaid'])   || data.amountPaid is number) &&
        (!data.keys().hasAny(['vatAmount'])    || data.vatAmount is number) &&
        (!data.keys().hasAny(['customerName']) || data.customerName is string) &&
        (!data.keys().hasAny(['customerId'])   || data.customerId is string);
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'unitPrice', 'currentStock']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.unitPrice is number && data.unitPrice >= 0 &&
        data.currentStock is number &&
        (!data.keys().hasAny(['category'])     || data.category is string) &&
        (!data.keys().hasAny(['sku'])          || data.sku is string) &&
        (!data.keys().hasAny(['costPrice'])    || data.costPrice is number) &&
        (!data.keys().hasAny(['isActive'])     || data.isActive is bool);
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['category', 'amount', 'date']) &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
        data.amount is string &&
        data.date is string && data.date.size() > 0 &&
        (!data.keys().hasAny(['status']) ||
          data.status in ['approved', 'pending', 'rejected']);
    }

    function isValidCashAccount(data) {
      return data.keys().hasAll(['name', 'type', 'balance']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.type is string && data.type.size() > 0 &&
        (data.balance is string || data.balance is number);
    }

    function isValidBudget(data) {
      return data.keys().hasAll(['category', 'amount', 'month', 'year']) &&
        data.category is string && data.category.size() > 0 &&
        data.amount is number && data.amount >= 0 &&
        data.month is int && data.month >= 1 && data.month <= 12 &&
        data.year is int && data.year >= 2000;
    }

    function isValidInvoicePayment(data) {
      return data.keys().hasAll(['invoiceId', 'amount', 'method']) &&
        data.invoiceId is string && data.invoiceId.size() > 0 &&
        data.amount is number && data.amount > 0 &&
        data.method is string && data.method.size() > 0 &&
        (!data.keys().hasAny(['customerId']) || data.customerId is string) &&
        (!data.keys().hasAny(['reference'])  || data.reference is string);
    }

    function isValidReceivable(data) {
      return data.keys().hasAll(['amount', 'outstanding', 'status']) &&
        data.amount is number && data.amount >= 0 &&
        data.outstanding is number && data.outstanding >= 0 &&
        data.status is string && data.status.size() > 0 &&
        (!data.keys().hasAny(['customerId']) || data.customerId is string) &&
        (!data.keys().hasAny(['invoiceId'])   || data.invoiceId is string);
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['partyName', 'type', 'originalAmount', 'paidAmount', 'status']) &&
        data.partyName is string && data.partyName.size() > 0 && data.partyName.size() <= 200 &&
        data.type in ['receivable', 'payable'] &&
        data.originalAmount is number && data.originalAmount >= 0 &&
        data.paidAmount is number && data.paidAmount >= 0 &&
        data.status is string && data.status.size() > 0;
    }

    function isValidDebtPayment(data) {
      return data.keys().hasAll(['amount', 'date', 'method']) &&
        data.amount is number && data.amount >= 0 &&
        data.date is string &&
        data.method is string;
    }

    function isValidPendingInviteCreate(data) {
      return data.keys().hasAll([
          'businessId', 'businessName', 'fullName', 'phoneNumber',
          'role', 'invitedBy', 'ownerUid', 'memberId', 'status', 'pinCreated'
        ]) &&
        data.businessId is string && data.businessName is string &&
        data.fullName is string && data.phoneNumber is string &&
        data.role is string && data.invitedBy is string &&
        data.ownerUid is string && data.memberId is string &&
        data.status == 'pending' && data.pinCreated == false &&
        data.ownerUid == request.auth.uid &&
        data.invitedBy == request.auth.uid;
    }

    // =========================================================================
    // USER PROFILES  (business owners)
    // =========================================================================
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidUserCreate(request.resource.data);
      // Phone lookup (login / onboarding): every real caller queries with
      // limit(1), signed in or not — a signed-in user must not be able to
      // run an unbounded query and dump every user's name/phone.
      allow list: if isLimitedLookup();
    }

    // =========================================================================
    // WORKER PROFILES  (employees / team members)
    // =========================================================================
    match /workers/{workerUid} {
      // Worker reads/writes their own profile.
      allow read, write: if isSignedIn() && isOwner(workerUid);
      // Owner creates the worker profile when sending an invite.
      allow create: if isSignedIn() && isValidWorkerCreate(request.resource.data);
      // NOTE: there is no current client feature reading another user's
      // worker profile (no ownerUid/businessId is stored on this doc to
      // scope such a read against), so no blanket read is granted here. If a
      // "show staff name/phone" feature needs this, store the owning
      // businessId on the document and scope the rule to that business's
      // owner instead of `isSignedIn()`.
    }

    // =========================================================================
    // BUSINESSES  (top-level — owned by a user)
    // Path: businesses/{bizId}
    // =========================================================================
    match /businesses/{bizId} {
      // Signed-in callers may only list businesses they own (the query must
      // filter on ownerUid == request.auth.uid — Firestore rejects any query
      // that isn't provably restricted this way). Unauthenticated pre-auth
      // phone lookup is still allowed but capped to a single result.
      allow list: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) ||
        (!isSignedIn() && isLimitedLookup());

      // Read: owner or any active staff member.
      allow get: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        isStaffWithAny(bizId, ['viewSales', 'viewCustomers', 'viewInventory',
          'viewCashFlow', 'viewDebt', 'createSale', 'manageCustomers',
          'manageExpenses', 'addStock', 'editStock'])
      );

      // Create: ownerUid must be the caller.
      allow create: if isSignedIn() && isValidBusinessCreate(request.resource.data);

      // Update / delete: owner only.
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // ── Customers ──────────────────────────────────────────────────────────
      match /customers/{customerId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewCustomers', 'manageCustomers', 'createSale']);
        allow create: if isOwnerOrStaffWithAny(bizId, ['manageCustomers', 'createSale']) &&
          isValidCustomer(request.resource.data);
        allow update, delete: if isOwnerOrStaffWithAny(bizId, ['manageCustomers']);
        allow update: if isOwnerOrStaffWithAny(bizId, ['createSale', 'editSale']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['balance', 'lastTransactionDate', 'updatedAt']);

        match /notes/{noteId} {
          allow read, create, update, delete: if isOwnerOrStaffWithAny(bizId, ['manageCustomers']);
        }

        match /payments/{paymentId} {
          allow read: if isOwnerOrStaffWithAny(bizId,
            ['viewDebt', 'viewCustomers', 'manageCustomers', 'createSale']);
          allow create: if isOwnerOrStaffWithAny(bizId,
            ['manageCustomers', 'grantCredit', 'manageDebt', 'createSale']);
          allow update, delete: if isOwnerOrStaffWithAny(bizId,
            ['manageCustomers', 'manageDebt']);
        }
      }

      // ── Sales invoices ─────────────────────────────────────────────────────
      match /sales_invoices/{invoiceId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewSales', 'createSale']);
        allow create: if isOwnerOrStaffWithAny(bizId, ['createSale']) &&
          isValidSaleInvoice(request.resource.data);
        allow update: if isOwnerOrStaffWithAny(bizId, ['editSale']);
        allow delete: if isOwnerOrStaffWithAny(bizId, ['deleteSale']);
      }

      match /invoice_payments/{paymentId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewSales', 'createSale']);
        allow create: if isOwnerOrStaffWithAny(bizId, ['createSale', 'editSale']) &&
          isValidInvoicePayment(request.resource.data);
        allow update, delete: if isSignedIn() && isBusinessOwner(bizId);
      }

      match /credit_notes/{creditNoteId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewSales', 'issueRefund']);
        allow create: if isOwnerOrStaffWithAny(bizId, ['issueRefund']);
        allow update, delete: if isSignedIn() && isBusinessOwner(bizId);
      }

      // ── Receivables & debts ────────────────────────────────────────────────
      match /receivables/{receivableId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewSales', 'viewDebt']);
        allow create: if isOwnerOrStaffWithAny(bizId, ['createSale', 'grantCredit']) &&
          isValidReceivable(request.resource.data);
        allow update, delete: if isOwnerOrStaffWithAny(bizId, ['manageDebt']);
      }

      match /debts/{debtId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewDebt', 'manageDebt', 'createSale']);
        // createSale  → credit invoices (receivables)
        // manageExpenses → expenses bought on credit (payables)
        // addStock       → inventory purchased on credit (payables)
        // manageDebt / grantCredit → manual debt entry
        allow create: if isOwnerOrStaffWithAny(bizId,
          ['createSale', 'manageDebt', 'grantCredit', 'manageExpenses', 'addStock']) &&
          isValidDebt(request.resource.data);
        allow update: if isOwnerOrStaffWithAny(bizId, ['manageDebt']);
        allow delete: if isOwnerOrStaffWithAny(bizId, ['writeOffDebt', 'manageDebt']);

        match /payments/{paymentId} {
          allow read: if isOwnerOrStaffWithAny(bizId, ['viewDebt', 'manageDebt']);
          allow create: if isOwnerOrStaffWithAny(bizId, ['viewDebt', 'manageDebt']) &&
            isValidDebtPayment(request.resource.data);
          allow update, delete: if isOwnerOrStaffWithAny(bizId, ['manageDebt']);
        }
      }

      // ── Inventory ──────────────────────────────────────────────────────────
      match /inventory_items/{itemId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewInventory']);

        // Full product creation (from the add-product form).
        allow create: if isOwnerOrStaffWithAny(bizId, ['addStock']) &&
          isValidInventoryItem(request.resource.data);

        // Sale / return batch writes a merge-stub {currentStock, updatedAt} when
        // the item does not yet exist in Firestore (offline-first race condition).
        // Allow this minimal create so the sale can complete; SyncService fills
        // in the remaining fields on the next successful push.
        allow create: if isOwnerOrStaffWithAny(bizId, ['createSale', 'issueRefund']) &&
          request.resource.data.keys().hasOnly(['currentStock', 'updatedAt']);

        // Full document updates (SyncService, stock editor).
        allow update: if isOwnerOrStaffWithAny(bizId, ['editStock', 'adjustStock']);

        // Sale / return stock deduction — only stock fields may change.
        // 'stock' is a legacy alias for 'currentStock' written by some older code paths.
        allow update: if isOwnerOrStaffWithAny(bizId, ['createSale', 'issueRefund']) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['currentStock', 'stock', 'updatedAt']);

        allow delete: if isOwnerOrStaffWithAny(bizId, ['deleteStock']);
      }

      // ── Expenses ───────────────────────────────────────────────────────────
      match /expenses/{expenseId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['manageExpenses']);
        allow create: if isOwnerOrStaffWithAny(bizId, ['manageExpenses']) &&
          isValidExpense(request.resource.data);
        allow update, delete: if isOwnerOrStaffWithAny(bizId, ['manageExpenses']);
      }

      match /expense_templates/{templateId} {
        allow read, update, delete: if isSignedIn() && isBusinessOwner(bizId);
        allow create: if isSignedIn() && isBusinessOwner(bizId);
      }

      // ── Cash accounts & budgets ────────────────────────────────────────────
      match /cash_accounts/{accountId} {
        allow read: if isOwnerOrStaffWithAny(bizId, ['viewCashFlow']);
        allow create: if isSignedIn() && isBusinessOwner(bizId) && isValidCashAccount(request.resource.data);
        allow update, delete: if isSignedIn() && isBusinessOwner(bizId);
      }

      match /budgets/{budgetId} {
        allow read, update, delete: if isSignedIn() && isBusinessOwner(bizId);
        allow create: if isSignedIn() && isBusinessOwner(bizId) && isValidBudget(request.resource.data);
      }

      // ── Product categories ─────────────────────────────────────────────────
      match /categories/{categoryId} {
        allow read: if isSignedIn() && isBusinessOwner(bizId);
        allow create: if isSignedIn() && isBusinessOwner(bizId) &&
          request.resource.data.keys().hasAll(['name']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 100;
        allow update: if isSignedIn() && isBusinessOwner(bizId) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0;
        allow delete: if isSignedIn() && isBusinessOwner(bizId);
      }

      // ── Staff  (replaces team_members + memberAccess) ──────────────────────
      // Doc ID = auto-generated on invite. Field `workerUid` is stamped when
      // the worker accepts (their Firebase Auth UID).
      match /staff/{staffId} {
        // Owner has full control.
        allow read, create, update, delete: if isSignedIn() && isBusinessOwner(bizId);
        // Active worker reads their own record.
        allow read: if isSignedIn() && resource.data.workerUid == request.auth.uid;
        // Phone lookup during login: collectionGroup query needs an explicit list
        // rule because Firestore can't evaluate resource.data in query context.
        // Pre-auth lookup (team member phone entry) runs before sign-in, so
        // unauthenticated limited queries must be allowed — same as users/businesses.
        allow list: if isLimitedLookup();
        // Worker accepts invite: stamps their UID + activates (updates the auto-gen-ID doc).
        allow update: if isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'workerUid', 'updatedAt']) &&
          request.resource.data.workerUid == request.auth.uid &&
          request.resource.data.status == 'active' &&
          (!('workerUid' in resource.data) || resource.data.workerUid == request.auth.uid) &&
          authEmailMatchesPhone(resource.data.phone);
        // Worker creates/updates the UID-keyed pointer doc at staff/{auth.uid}.
        // Permissions are mirrored from the owner-controlled auto-gen doc and the
        // rule enforces equality, so a worker cannot self-elevate their permissions.
        allow create, update: if isSignedIn() &&
          staffId == request.auth.uid &&
          request.resource.data.workerUid == request.auth.uid &&
          request.resource.data.status == 'active' &&
          request.resource.data.memberId is string &&
          request.resource.data.memberId.size() > 0 &&
          authEmailMatchesPhone(request.resource.data.phone) &&
          exists(/databases/$(database)/documents/businesses/$(bizId)/staff/$(request.resource.data.memberId)) &&
          request.resource.data.permissions is list &&
          request.resource.data.permissions == get(
            /databases/$(database)/documents/businesses/$(bizId)/staff/$(request.resource.data.memberId)
          ).data.permissions &&
          request.resource.data.keys().hasOnly(
            ['workerUid', 'memberId', 'permissions', 'phone', 'status', 'createdAt', 'updatedAt']);
      }

      // ── Audit logs ────────────────────────────────────────────────────────
      match /audit_logs/{logId} {
        allow read: if isSignedIn() && isBusinessOwner(bizId);
        allow create: if isOwnerOrStaffWithAny(bizId,
          ['manageCustomers', 'grantCredit', 'createSale', 'editSale', 'issueRefund']);
      }

      // Fallback for any other subcollection
      match /{collection}/{docId} {
        allow read, create, update, delete: if isSignedIn() && isBusinessOwner(bizId);
      }
    }

    // =========================================================================
    // PENDING INVITES  (top-level for pre-auth phone lookup)
    // =========================================================================
    match /pendingInvites/{inviteId} {
      allow get: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      // Every real caller (owner lookups and pre-auth team-member phone
      // lookups alike) queries with limit(1) — a signed-in user must not be
      // able to run an unbounded query and dump every business's pending
      // invites (names/phones/roles) across every tenant.
      allow list: if isLimitedLookup();

      allow create: if isSignedIn() && isValidPendingInviteCreate(request.resource.data);

      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Worker accepts invite: stamps their UID, flips status.
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'pinCreated', 'acceptedAt', 'uid']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'accepted' &&
        authEmailMatchesPhone(resource.data.phoneNumber);

      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // =========================================================================
    // PUBLIC LOOKUPS  (app bootstrap data — business types, cities, districts)
    // =========================================================================
    match /lookups/{lookupId} {
      allow read: if true;
      allow write: if isCms();
    }

    // =========================================================================
    // MASTER CATALOG  (global, Mali Up managed)
    // =========================================================================
    match /master_categories/{categoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.source == 'community'
        && request.resource.data.businessTypeId is string
        && request.resource.data.businessTypeId.size() > 0
        && request.resource.data.categoryName is string
        && request.resource.data.categoryName.size() > 0
        && request.resource.data.categoryName.size() <= 100;
      allow update, delete: if isCms();
    }

    match /master_products/{productId} {
      allow read: if isSignedIn();
      allow write: if isCms();
    }

    // =========================================================================
    // PLATFORM CONFIG  (plan definitions — edited from the admin portal)
    // =========================================================================
    // Only the plans doc is exposed; other config docs (e.g. main) stay denied.
    // Writes happen through the admin portal's Admin SDK, which bypasses rules.
    match /platform_config/plans {
      allow read: if true;
    }

    // =========================================================================
    // PLAN REQUESTS  (enterprise inquiries + payment confirmations from the app)
    // =========================================================================
    match /plan_requests/{requestId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type in ['enterprise_inquiry', 'payment_claim'] &&
        request.resource.data.requestedTier in ['growth', 'business', 'enterprise'] &&
        (!request.resource.data.keys().hasAny(['note']) ||
          (request.resource.data.note is string && request.resource.data.note.size() <= 1000)) &&
        (!request.resource.data.keys().hasAny(['paymentRef']) ||
          request.resource.data.paymentRef is string);
      // User can see their own requests (e.g. "request already sent" state).
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      // No client updates/deletes — requests are resolved from the admin portal.
    }

    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
