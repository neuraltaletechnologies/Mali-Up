rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if the authenticated user matches the given userId
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Helper function to validate business document ownership
    function isBusinessOwner(ownerId) {
      return isSignedIn() && isOwner(ownerId);
    }

    // Helper function for importing customer/contact records from phone.
    // Allows required customer identity fields and optional metadata fields.
    function isValidImportedCustomer(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.phone.size() > 0 &&
        data.name.size() <= 120 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['email']) || data.email is string) &&
        (!data.keys().hasAny(['balance']) || data.balance is string || data.balance is number) &&
        (!data.keys().hasAny(['lastTransactionDate']) || data.lastTransactionDate is string) &&
        (!data.keys().hasAny(['tags']) || data.tags is list);
    }
    
    // ============================================
    // USER PROFILES
    // ============================================
    match /users/{userId} {
      // Users can only read and write their own profile
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      
      // Allow creation of user profile during registration
      allow create: if isSignedIn() && isOwner(userId);
      
      // Allow pre-auth phone lookup used by login/registration flows
      // App queries this path with where('phone', ...).limit(1)
      allow list: if isSignedIn() || (request.auth == null && request.query.limit != null && request.query.limit <= 1);
      
      // ============================================
      // PERSONAL FINANCE - FUTURE IMPLEMENTATION (v1.5)
      // ============================================
      // Personal finance data - only accessible by the owner
      match /personal/{document=**} {
        allow read, write: if isSignedIn() && isOwner(userId);
      }
    }
    
    // ============================================
    // BUSINESS COLLECTIONS
    // ============================================
    // Business documents are scoped by ownerId (which equals the user's uid)
    match /business/{ownerId} {
      // Only the owner can access their business document
      allow read, write: if isBusinessOwner(ownerId);
      
      // All subcollections inherit the owner check
      // Users can only access documents within their own business
      
      // INVOICES
      match /invoices/{invoiceId} {
        allow read, write: if isBusinessOwner(ownerId);
        // Prevent creating invoices with mismatched ownerId
        allow create: if isBusinessOwner(ownerId) && request.resource.data.ownerId == ownerId;
      }
      
      // CUSTOMERS
      match /customers/{customerId} {
        allow read, update, delete: if isBusinessOwner(ownerId);
        // Explicitly allow bulk contact imports from phone.
        allow create: if isBusinessOwner(ownerId) && isValidImportedCustomer(request.resource.data);
      }
      
      // EXPENSES
      match /expenses/{expenseId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId);
      }
      
      // INVENTORY
      match /inventory/{itemId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId);
      }
      
      // SETTINGS
      match /settings/{settingId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId);
      }
      
      // CASH FLOW
      match /cashFlow/{cashFlowId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId);
      }
      
      // SUPPLIERS
      match /suppliers/{supplierId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId);
      }
      
      // STAFF
      match /staff/{staffId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId);
      }
    }
    
    // ============================================
    // TENANT-SCOPED BUSINESSES (for multi-tenant support)
    // ============================================
    match /tenants/{tenantId} {
      allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);

      // Direct customers subcollection when no businessId is resolved.
      // Supports importing multiple contacts/customers from phone.
      match /customers/{customerId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) && isValidImportedCustomer(request.resource.data);
      }

      // Direct subcollections when no businessId is resolved
      match /{collection}/{docId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
      }

      match /businesses/{businessId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);

        // Customer subcollection for business context.
        // Supports importing multiple contacts/customers from phone.
        match /customers/{customerId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) && isValidImportedCustomer(request.resource.data);
        }

        // All subcollections: sales_invoices, customers, inventory_items,
        // expenses, cash_accounts, debts, suppliers, staff, settings, etc.
        match /{collection}/{docId} {
          allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
        }
      }
    }

    // ============================================
    // PERSONAL ACCOUNTS (for users operating outside business context)
    // ============================================
    match /personal_accounts/{userId} {
      allow read, create, update, delete: if isSignedIn() && isOwner(userId);

      // Personal-context customers import.
      match /customers/{customerId} {
        allow read, update, delete: if isSignedIn() && isOwner(userId);
        allow create: if isSignedIn() && isOwner(userId) && isValidImportedCustomer(request.resource.data);
      }

      // All subcollections: sales_invoices, expenses, cash_accounts,
      // customers, debts, inventory_items, etc.
      match /{collection}/{docId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(userId);
      }
    }
    
    // ============================================
    // DEBT COLLECTIONS (Debt Exposure)
    // ============================================
    match /debt_collections/{collectionId} {
      // Only the owner of the business the collection belongs to can access it
      allow read, write: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
    
    // ============================================
    // DEFAULT DENY RULE
    // ============================================
    // Deny all access to any documents not covered by the rules above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
