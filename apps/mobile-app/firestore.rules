rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isBusinessOwner(ownerId) {
      return isSignedIn() && isOwner(ownerId);
    }

    // Validates required fields for a customer/contact imported from phone.
    function isValidImportedCustomer(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.phone.size() > 0 &&
        data.name.size() <= 120 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['email']) || data.email is string) &&
        (!data.keys().hasAny(['balance']) || data.balance is string || data.balance is number) &&
        (!data.keys().hasAny(['lastTransactionDate']) || data.lastTransactionDate is string) &&
        (!data.keys().hasAny(['tags']) || data.tags is list);
    }

    // Validates a new user profile on registration.
    // Ensures phone + name are present and account type is a supported value.
    function isValidUserCreate(data) {
      return data.keys().hasAll(['phone', 'name']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.phone.size() > 0 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['defaultAccountType']) ||
          data.defaultAccountType in ['business']) &&
        (!data.keys().hasAny(['accountTypes']) || data.accountTypes is list) &&
        (!data.keys().hasAny(['usagePreference']) ||
          data.usagePreference in ['business']);
    }

    // Validates a business document created under a tenant.
    // Enforces that ownerUid matches the authenticated tenant so a user cannot
    // create a business claiming to belong to someone else.
    function isValidBusinessCreate(data, tenantId) {
      return data.keys().hasAll(['id', 'businessName', 'ownerUid']) &&
        data.ownerUid == tenantId &&
        data.id is string &&
        data.id.size() > 0 &&
        data.businessName is string &&
        data.businessName.size() > 0 &&
        data.businessName.size() <= 200;
    }

    // ============================================
    // USER PROFILES
    // ============================================
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) &&
        isValidUserCreate(request.resource.data);
      // Phone lookup used by login/registration flows.
      // Unauthenticated access is limited to limit <= 1 to support pre-auth
      // phone existence checks (phone_auth_service.dart sendOTP).
      allow list: if isSignedIn() ||
        (request.auth == null &&
         request.query.limit != null &&
         request.query.limit <= 1);
    }

    // ============================================
    // LEGACY BUSINESS COLLECTION
    // ============================================
    // Used by auth_service.dart during sign-up / profile migration.
    match /business/{ownerId} {
      allow read, write: if isBusinessOwner(ownerId);

      match /invoices/{invoiceId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && request.resource.data.ownerId == ownerId;
      }

      match /customers/{customerId} {
        allow read, update, delete: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && isValidImportedCustomer(request.resource.data);
      }

      match /expenses/{expenseId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /inventory/{itemId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /settings/{settingId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /cashFlow/{cashFlowId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /suppliers/{supplierId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /staff/{staffId} {
        allow read, write: if isBusinessOwner(ownerId);
      }
    }

    // ============================================
    // TENANT-SCOPED BUSINESSES (primary data path)
    // Path: tenants/{uid}/businesses/{businessId}/{collection}/{docId}
    // ============================================
    match /tenants/{tenantId} {
      allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);

      // Fallback: direct customer import before a businessId is resolved
      match /customers/{customerId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidImportedCustomer(request.resource.data);
      }

      // Fallback: any direct subcollection before a businessId is resolved
      match /{collection}/{docId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
      }

      match /businesses/{businessId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        // Require ownerUid to match the tenant on creation to prevent a user
        // from forging a business document under another user's tenant path.
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidBusinessCreate(request.resource.data, tenantId);

        // Customer import for a specific business
        match /customers/{customerId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidImportedCustomer(request.resource.data);
        }

        // All business subcollections:
        // sales_invoices, inventory_items, expenses, cash_accounts,
        // debts, suppliers, staff, settings, cash_flow, etc.
        match /{collection}/{docId} {
          allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
        }
      }
    }

    // ============================================
    // DEBT COLLECTIONS (standalone exposure tracker)
    // ============================================
    match /debt_collections/{collectionId} {
      allow read, write: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
