rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isBusinessOwner(ownerId) {
      return isSignedIn() && isOwner(ownerId);
    }

    // Validates a customer document (individual or organisation).
    // Requires name + phone; optionally allows all known fields.
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['email'])             || data.email is string) &&
        (!data.keys().hasAny(['balance'])            || data.balance is string || data.balance is number) &&
        (!data.keys().hasAny(['lastTransactionDate'])|| data.lastTransactionDate is string || data.lastTransactionDate is timestamp) &&
        (!data.keys().hasAny(['tags'])               || data.tags is list) &&
        (!data.keys().hasAny(['isOrganisation'])     || data.isOrganisation is bool) &&
        (!data.keys().hasAny(['tinNumber'])          || data.tinNumber is string) &&
        (!data.keys().hasAny(['address'])            || data.address is string);
    }

    // Kept as an alias so existing callers still work.
    function isValidImportedCustomer(data) {
      return isValidCustomer(data);
    }

    // Validates a new user profile on registration.
    function isValidUserCreate(data) {
      return data.keys().hasAll(['phone', 'name']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.phone.size() > 0 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['defaultAccountType']) ||
          data.defaultAccountType in ['business']) &&
        (!data.keys().hasAny(['accountTypes'])       || data.accountTypes is list) &&
        (!data.keys().hasAny(['usagePreference'])    ||
          data.usagePreference in ['business']);
    }

    // Validates a business document created under a tenant.
    function isValidBusinessCreate(data, tenantId) {
      return data.keys().hasAll(['id', 'businessName', 'ownerUid']) &&
        data.ownerUid == tenantId &&
        data.id is string &&
        data.id.size() > 0 &&
        data.businessName is string &&
        data.businessName.size() > 0 &&
        data.businessName.size() <= 200;
    }

    // Validates a sale invoice document.
    // Required: amount (number), items (list), status, createdAt.
    // Optional: customerName, customerId, amountPaid, paymentMethod, etc.
    function isValidSaleInvoice(data) {
      return data.keys().hasAll(['amount', 'items', 'status']) &&
        data.amount is number &&
        data.amount >= 0 &&
        data.items is list &&
        data.status in ['Paid', 'Partial', 'Unpaid', 'Pending'] &&
        (!data.keys().hasAny(['amountPaid'])      || data.amountPaid is number) &&
        (!data.keys().hasAny(['customerName'])    || data.customerName is string) &&
        (!data.keys().hasAny(['customerId'])      || data.customerId is string) &&
        (!data.keys().hasAny(['customerPhone'])   || data.customerPhone is string) &&
        (!data.keys().hasAny(['isOrganisation'])  || data.isOrganisation is bool) &&
        (!data.keys().hasAny(['customerTin'])     || data.customerTin is string) &&
        (!data.keys().hasAny(['invoiceNumber'])   || data.invoiceNumber is string) &&
        (!data.keys().hasAny(['paymentMethod'])   || data.paymentMethod is string);
    }

    // Validates an inventory item document.
    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'unitPrice', 'currentStock']) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.unitPrice is number &&
        data.unitPrice >= 0 &&
        data.currentStock is number &&
        (!data.keys().hasAny(['category'])      || data.category is string) &&
        (!data.keys().hasAny(['sku'])           || data.sku is string) &&
        (!data.keys().hasAny(['unit'])          || data.unit is string) &&
        (!data.keys().hasAny(['supplier'])      || data.supplier is string) &&
        (!data.keys().hasAny(['reorderPoint'])  || data.reorderPoint is number) &&
        (!data.keys().hasAny(['description'])   || data.description is string) &&
        (!data.keys().hasAny(['isActive'])      || data.isActive is bool);
    }

    // ============================================
    // USER PROFILES
    // ============================================
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) &&
        isValidUserCreate(request.resource.data);
      allow list: if isSignedIn() ||
        (request.auth == null &&
         request.query.limit != null &&
         request.query.limit <= 1);
    }

    // ============================================
    // LEGACY BUSINESS COLLECTION
    // ============================================
    match /business/{ownerId} {
      allow read, write: if isBusinessOwner(ownerId);

      match /invoices/{invoiceId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && request.resource.data.ownerId == ownerId;
      }

      match /customers/{customerId} {
        allow read, update, delete: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && isValidCustomer(request.resource.data);
      }

      match /expenses/{expenseId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /inventory/{itemId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /settings/{settingId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /cashFlow/{cashFlowId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /suppliers/{supplierId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /staff/{staffId} {
        allow read, write: if isBusinessOwner(ownerId);
      }
    }

    // ============================================
    // TENANT-SCOPED BUSINESSES (primary data path)
    // Path: tenants/{uid}/businesses/{businessId}/{collection}/{docId}
    // ============================================
    match /tenants/{tenantId} {
      allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);

      // Direct customer access before a businessId is resolved
      match /customers/{customerId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidCustomer(request.resource.data);
      }

      // Direct sales_invoices access before a businessId is resolved
      match /sales_invoices/{invoiceId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidSaleInvoice(request.resource.data);
      }

      // Direct inventory_items access before a businessId is resolved
      match /inventory_items/{itemId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidInventoryItem(request.resource.data);
      }

      // Fallback: any direct subcollection before a businessId is resolved
      match /{collection}/{docId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
      }

      match /businesses/{businessId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidBusinessCreate(request.resource.data, tenantId);

        // Customers for a specific business
        match /customers/{customerId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidCustomer(request.resource.data);
        }

        // Sales invoices for a specific business
        match /sales_invoices/{invoiceId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidSaleInvoice(request.resource.data);
        }

        // Inventory items for a specific business
        match /inventory_items/{itemId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidInventoryItem(request.resource.data);
        }

        // All other business subcollections (expenses, cash_accounts, debts, etc.)
        match /{collection}/{docId} {
          allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
        }
      }
    }

    // ============================================
    // DEBT COLLECTIONS (standalone exposure tracker)
    // ============================================
    match /debt_collections/{collectionId} {
      allow read, write: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
