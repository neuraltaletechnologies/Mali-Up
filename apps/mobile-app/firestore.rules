rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isBusinessOwner(ownerId) {
      return isSignedIn() && isOwner(ownerId);
    }

    // ── Validators ────────────────────────────────────────────────────────────

    // Customer (individual or organisation)
    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'phone']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['email'])              || data.email is string) &&
        (!data.keys().hasAny(['balance'])             || data.balance is string || data.balance is number) &&
        (!data.keys().hasAny(['lastTransactionDate']) || data.lastTransactionDate is string || data.lastTransactionDate is timestamp) &&
        (!data.keys().hasAny(['tags'])                || data.tags is list) &&
        (!data.keys().hasAny(['isOrganisation'])      || data.isOrganisation is bool) &&
        (!data.keys().hasAny(['tinNumber'])           || data.tinNumber is string) &&
        (!data.keys().hasAny(['address'])             || data.address is string);
    }

    function isValidImportedCustomer(data) {
      return isValidCustomer(data);
    }

    // New user profile on registration
    function isValidUserCreate(data) {
      return data.keys().hasAll(['phone', 'name']) &&
        data.name is string &&
        data.phone is string &&
        data.name.size() > 0 &&
        data.name.size() <= 120 &&
        data.phone.size() > 0 &&
        data.phone.size() <= 32 &&
        (!data.keys().hasAny(['defaultAccountType']) ||
          data.defaultAccountType in ['business']) &&
        (!data.keys().hasAny(['accountTypes'])       || data.accountTypes is list) &&
        (!data.keys().hasAny(['usagePreference'])    ||
          data.usagePreference in ['business']);
    }

    // Business document under a tenant
    function isValidBusinessCreate(data, tenantId) {
      return data.keys().hasAll(['id', 'businessName', 'ownerUid']) &&
        data.ownerUid == tenantId &&
        data.id is string &&
        data.id.size() > 0 &&
        data.businessName is string &&
        data.businessName.size() > 0 &&
        data.businessName.size() <= 200;
    }

    // Sales invoice — status kept as a free string so all casing variants
    // (Paid / paid / Completed / completed / partial / Unpaid etc.) are accepted.
    function isValidSaleInvoice(data) {
      return data.keys().hasAll(['amount', 'items', 'status']) &&
        data.amount is number &&
        data.amount >= 0 &&
        data.items is list &&
        data.status is string &&
        data.status.size() > 0 &&
        data.status.size() <= 50 &&
        (!data.keys().hasAny(['totalAmount'])     || data.totalAmount is number) &&
        (!data.keys().hasAny(['amountPaid'])      || data.amountPaid is number) &&
        (!data.keys().hasAny(['vatAmount'])       || data.vatAmount is number) &&
        (!data.keys().hasAny(['customerName'])    || data.customerName is string) &&
        (!data.keys().hasAny(['customerId'])      || data.customerId is string) &&
        (!data.keys().hasAny(['customerPhone'])   || data.customerPhone is string) &&
        (!data.keys().hasAny(['isOrganisation'])  || data.isOrganisation is bool) &&
        (!data.keys().hasAny(['customerTin'])     || data.customerTin is string) &&
        (!data.keys().hasAny(['invoiceNumber'])   || data.invoiceNumber is string) &&
        (!data.keys().hasAny(['paymentMethod'])   || data.paymentMethod is string);
    }

    // Inventory item
    function isValidInventoryItem(data) {
      return data.keys().hasAll(['name', 'unitPrice', 'currentStock']) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 200 &&
        data.unitPrice is number &&
        data.unitPrice >= 0 &&
        data.currentStock is number &&
        (!data.keys().hasAny(['category'])      || data.category is string) &&
        (!data.keys().hasAny(['sku'])           || data.sku is string) &&
        (!data.keys().hasAny(['unit'])          || data.unit is string) &&
        (!data.keys().hasAny(['supplier'])      || data.supplier is string) &&
        (!data.keys().hasAny(['reorderPoint'])  || data.reorderPoint is number) &&
        (!data.keys().hasAny(['description'])   || data.description is string) &&
        (!data.keys().hasAny(['costPrice'])     || data.costPrice is number) &&
        (!data.keys().hasAny(['isActive'])      || data.isActive is bool);
    }

    // Expense — status: 'approved' | 'pending' | 'rejected'
    function isValidExpense(data) {
      return data.keys().hasAll(['category', 'amount', 'date']) &&
        data.category is string &&
        data.category.size() > 0 &&
        data.category.size() <= 100 &&
        data.amount is string &&
        data.date is string &&
        data.date.size() > 0 &&
        (!data.keys().hasAny(['note'])          || data.note is string) &&
        (!data.keys().hasAny(['recipient'])     || data.recipient is string) &&
        (!data.keys().hasAny(['paymentMethod']) || data.paymentMethod is string) &&
        (!data.keys().hasAny(['status'])        ||
          data.status in ['approved', 'pending', 'rejected']) &&
        (!data.keys().hasAny(['isRecurring'])   || data.isRecurring is bool) &&
        (!data.keys().hasAny(['receiptUrl'])    || data.receiptUrl is string) &&
        (!data.keys().hasAny(['createdBy'])     || data.createdBy is string) &&
        (!data.keys().hasAny(['approvedBy'])    || data.approvedBy is string);
    }

    // Cash account (petty cash, mobile money, bank)
    function isValidCashAccount(data) {
      return data.keys().hasAll(['name', 'type', 'balance']) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        data.type is string &&
        data.type.size() > 0 &&
        (data.balance is string || data.balance is number) &&
        (!data.keys().hasAny(['lastReconciled']) || data.lastReconciled is string);
    }

    // Monthly budget entry
    function isValidBudget(data) {
      return data.keys().hasAll(['category', 'amount', 'month', 'year']) &&
        data.category is string &&
        data.category.size() > 0 &&
        data.amount is number &&
        data.amount >= 0 &&
        data.month is int &&
        data.month >= 1 &&
        data.month <= 12 &&
        data.year is int &&
        data.year >= 2000;
    }

    // Recurring expense template
    function isValidExpenseTemplate(data) {
      return data.keys().hasAll(['category', 'amount', 'recurrenceType']) &&
        data.category is string &&
        data.category.size() > 0 &&
        data.recurrenceType in ['monthly', 'weekly', 'daily'] &&
        (!data.keys().hasAny(['note'])          || data.note is string) &&
        (!data.keys().hasAny(['recipient'])     || data.recipient is string) &&
        (!data.keys().hasAny(['paymentMethod']) || data.paymentMethod is string);
    }

    // =========================================================================
    // USER PROFILES
    // =========================================================================
    match /users/{userId} {
      allow read, update, delete: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) &&
        isValidUserCreate(request.resource.data);
      // Allow unauthenticated phone lookups (app bootstrap / login)
      allow list: if isSignedIn() ||
        (request.auth == null &&
         request.query.limit != null &&
         request.query.limit <= 1);
    }

    // =========================================================================
    // LEGACY BUSINESS COLLECTION
    // =========================================================================
    match /business/{ownerId} {
      allow read, write: if isBusinessOwner(ownerId);

      match /invoices/{invoiceId} {
        allow read, write: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && request.resource.data.ownerId == ownerId;
      }

      match /customers/{customerId} {
        allow read, update, delete: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && isValidCustomer(request.resource.data);
      }

      match /expenses/{expenseId} {
        allow read, update, delete: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && isValidExpense(request.resource.data);
      }

      match /cash_accounts/{accountId} {
        allow read, update, delete: if isBusinessOwner(ownerId);
        allow create: if isBusinessOwner(ownerId) && isValidCashAccount(request.resource.data);
      }

      match /inventory/{itemId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /settings/{settingId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /cashFlow/{cashFlowId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /suppliers/{supplierId} {
        allow read, write: if isBusinessOwner(ownerId);
      }

      match /staff/{staffId} {
        allow read, write: if isBusinessOwner(ownerId);
      }
    }

    // =========================================================================
    // TENANT-SCOPED BUSINESSES (primary data path)
    // tenants/{uid}/[businesses/{businessId}/]{collection}/{docId}
    // =========================================================================
    match /tenants/{tenantId} {
      allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);

      // ── Direct collections (before businessId is resolved) ─────────────────

      match /customers/{customerId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidCustomer(request.resource.data);
      }

      match /sales_invoices/{invoiceId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidSaleInvoice(request.resource.data);
      }

      match /inventory_items/{itemId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidInventoryItem(request.resource.data);
      }

      match /expenses/{expenseId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidExpense(request.resource.data);
      }

      match /cash_accounts/{accountId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidCashAccount(request.resource.data);
      }

      match /budgets/{budgetId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidBudget(request.resource.data);
      }

      match /expense_templates/{templateId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidExpenseTemplate(request.resource.data);
      }

      // Fallback for any other direct subcollection
      match /{collection}/{docId} {
        allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
      }

      // ── Business-scoped collections ─────────────────────────────────────────

      match /businesses/{businessId} {
        allow read, update, delete: if isSignedIn() && isOwner(tenantId);
        allow create: if isSignedIn() && isOwner(tenantId) &&
          isValidBusinessCreate(request.resource.data, tenantId);

        match /customers/{customerId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidCustomer(request.resource.data);
        }

        match /sales_invoices/{invoiceId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidSaleInvoice(request.resource.data);
        }

        match /inventory_items/{itemId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidInventoryItem(request.resource.data);
        }

        match /expenses/{expenseId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidExpense(request.resource.data);
        }

        match /cash_accounts/{accountId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidCashAccount(request.resource.data);
        }

        match /budgets/{budgetId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidBudget(request.resource.data);
        }

        match /expense_templates/{templateId} {
          allow read, update, delete: if isSignedIn() && isOwner(tenantId);
          allow create: if isSignedIn() && isOwner(tenantId) &&
            isValidExpenseTemplate(request.resource.data);
        }

        // Fallback for any other subcollection (debts, team_members, etc.)
        match /{collection}/{docId} {
          allow read, create, update, delete: if isSignedIn() && isOwner(tenantId);
        }
      }
    }

    // =========================================================================
    // DEBT COLLECTIONS (standalone tracker)
    // =========================================================================
    match /debt_collections/{collectionId} {
      allow read, write: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // =========================================================================
    // PUBLIC LOOKUPS (app bootstrap / onboarding data)
    // =========================================================================
    match /lookups/{lookupId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
