# Plain (non-secret) environment variables for Mali Up Cloud Functions.
#
# Copy this file to `.env` (gitignored) and fill in real values, then
# `firebase deploy --only functions`. `.env` is loaded by both the deploy
# and the emulator; `.env.local` (also gitignored) overrides it for the
# emulator only and is never deployed.
#
# The ClickPesa *client id* and *api key* are NOT here — those are Secret
# Manager secrets (`firebase functions:secrets:set …`), see CLICKPESA_INTEGRATION.md.

# ClickPesa payload checksum key. Only needed when checksum validation is
# turned ON for the application in the ClickPesa dashboard
# (Settings → Developers → Checksum). Copy the key shown there. When unset,
# initiateClickPesaPayment sends no checksum field — which ClickPesa rejects
# with "checksum is required" if validation is enabled.
CLICKPESA_CHECKSUM_KEY=

# PIN recovery (functions/src/pin_recovery.ts). RESEND_API_KEY is a Secret
# Manager secret (`firebase functions:secrets:set RESEND_API_KEY`), NOT here.
# These two are plain config with safe defaults — override only if the link
# domain or the verified Resend sender changes. See PIN_RECOVERY.md.
PIN_RECOVERY_LINK_BASE=https://maliup.neuraltale.com/reset-pin
PIN_RECOVERY_EMAIL_FROM=Mali Up <security@neuraltale.com>

# Beem Africa OTP (functions/src/beem_otp.ts). BEEM_API_KEY / BEEM_SECRET_KEY
# are Secret Manager secrets (`firebase functions:secrets:set BEEM_API_KEY`
# / `BEEM_SECRET_KEY`), NOT here. This is the OTP *application* ID created in
# the Beem dashboard (OTP → Applications) — not secret, but required. See
# BEEM_OTP_INTEGRATION.md.
BEEM_OTP_APP_ID=
