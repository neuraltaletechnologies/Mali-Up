# ─── Copy this file to .env.local and fill in all values ────────────────────
# Never commit .env.local — it is gitignored.

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-32-char-random-string
# In production (Cloudflare): set AUTH_URL=https://maliup.neuraltale.com
# AUTH_TRUST_HOST=true is required on Cloudflare Workers (set it in wrangler.toml [vars])
AUTH_URL=http://localhost:3001

# ─── Firebase Admin SDK (server-side) ────────────────────────────────────────
# Download from: Firebase Console → Project settings → Service accounts
#                → Generate new private key
# The JSON file contains all three values below.
FIREBASE_PROJECT_ID=neuraltale-mali-up
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@neuraltale-mali-up.iam.gserviceaccount.com
# Paste the private_key value — keep the literal \n escape sequences as-is.
# In shell: export FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Development shortcut: set this to skip the Firestore /platform_admins
# document check. Custom claim still required.
# SKIP_FIRESTORE_ADMIN_CHECK=true

# ─── Firebase Client SDK (browser-side) ──────────────────────────────────────
# Copy from: Firebase Console → Project settings → Your apps → Web app → Config
# These are public-safe — they identify the project, not grant access.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=neuraltale-mali-up
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=neuraltale-mali-up.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=neuraltale-mali-up.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=596683133951
NEXT_PUBLIC_FIREBASE_APP_ID=1:596683133951:web:...

# ─── Google Play Console install reports (optional) ──────────────────────────
# Powers the "Growth & Retention" section on the dashboard (installs /
# uninstalls / acquisition funnel). Data comes from Play Console's exported
# CSV reports in a private Cloud Storage bucket — see docs/play-console-reports.md.
# Leave unset and the dashboard shows a "Connect Google Play Console" card.
PLAY_REPORTS_BUCKET=pubsite_prod_0000000000000000000
PLAY_PACKAGE_NAME=com.neuraltale.maliup
# Optional dedicated service account for report access. If unset, the
# FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY above are used instead — that
# SA must then be granted read access to the report bucket.
# PLAY_SA_CLIENT_EMAIL=play-reports@neuraltale-mali-up.iam.gserviceaccount.com
# PLAY_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Admin API microservice ───────────────────────────────────────────────────
# Set once the Admin API service is running. Leave empty to use mock data.
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000
